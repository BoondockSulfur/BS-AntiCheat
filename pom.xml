<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.boondock</groupId>
  <artifactId>bsanticheat</artifactId>
  <version>1.0.5</version>
  <name>BSAntiCheat</name>
  <description>AntiCheat plugin for Paper 1.21.x with Movement and XRay detection</description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <paperapi.version>1.21.10-R0.1-SNAPSHOT</paperapi.version>
    <hikaricp.version>5.1.0</hikaricp.version>
    <sqlite.version>3.46.0.0</sqlite.version>
    <!-- MockBukkit builds against JUnit 6, so the whole test stack has to be JUnit 6 —
         mixing it with 5.x puts two incompatible junit-platform versions on the classpath
         and Surefire dies before running anything. Surefire 3.5.6 for the same reason.
         These need one online build to fetch; afterwards `mvn -o` works as before. -->
    <junit.version>6.0.2</junit.version>
    <surefire.version>3.5.6</surefire.version>
    <mockbukkit.version>4.99.0</mockbukkit.version>
  </properties>

  <repositories>
    <repository>
      <id>papermc-repo</id>
      <url>https://repo.papermc.io/repository/maven-public/</url>
    </repository>
    <repository>
      <id>lucko</id>
      <url>https://repo.lucko.me/</url>
    </repository>
    <repository>
      <id>codemc</id>
      <url>https://repo.codemc.io/repository/maven-releases/</url>
    </repository>
    <repository>
      <id>extendedclip</id>
      <url>https://repo.extendedclip.com/releases/</url>
    </repository>
  </repositories>

  <dependencies>
    <!-- Tests cover the decision logic that can be reached without a running server:
         the interval statistics behind AutoClicker and the vein clustering behind X-Ray.
         Both are where this plugin's false positives came from, and both are pure
         functions of their input once lifted out of the event handlers. -->
    <!-- MockBukkit must come before paper-api: it provides a running server implementation
         for tests, and the first match on the classpath wins. -->
    <dependency>
      <groupId>org.mockbukkit.mockbukkit</groupId>
      <artifactId>mockbukkit-v1.21</artifactId>
      <version>${mockbukkit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.papermc.paper</groupId>
      <artifactId>paper-api</artifactId>
      <version>${paperapi.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>net.luckperms</groupId>
      <artifactId>api</artifactId>
      <version>5.4</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
      <version>${hikaricp.version}</version>
    </dependency>
    <!-- Paper bundles sqlite-jdbc — shading it breaks: minimizeJar strips the
         reflectively-loaded driver classes and relocating org.sqlite would break
         the JNI symbols of the native library. -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>${sqlite.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- Paper bundles slf4j; shading an unrelocated copy gives HikariCP a
         binding-less (NOP) logger via the child-first plugin classloader. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>2.0.9</version>
      <scope>provided</scope>
    </dependency>
    <!-- Gson comes from the server (Paper bundles it). Declared explicitly so the
         UpdateChecker's compile-time use of it is visible instead of relying on a
         transitive paper-api dependency that could disappear without notice. -->
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.10.1</version>
      <scope>provided</scope>
    </dependency>
    <!-- PacketEvents is used as an installed server plugin (not shaded), to avoid
         conflicting with a standalone PacketEvents/ProtocolLib in the netty pipeline. -->
    <dependency>
      <groupId>com.github.retrooper</groupId>
      <artifactId>packetevents-spigot</artifactId>
      <version>2.12.1</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.bstats</groupId>
      <artifactId>bstats-bukkit</artifactId>
      <version>3.0.2</version>
    </dependency>
    <dependency>
      <groupId>me.clip</groupId>
      <artifactId>placeholderapi</artifactId>
      <version>2.11.6</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>BSAntiCheat-${project.version}</finalName>
    <!-- plugin.yml takes its version from the POM. It used to carry a hand-written copy,
         which silently went stale: a jar built as 1.0.4 still announced 1.0.3 to the server,
         so /version and the startup log could not tell two different builds apart. Only
         plugin.yml is filtered — config.yml and the language files must keep their contents
         verbatim. -->
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>plugin.yml</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>plugin.yml</exclude>
        </excludes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire.version}</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <!-- 3.11.0 cannot be used with a JDK 25 toolchain: its incremental-compile scan
             throws CompilerException: ConcurrentModificationException before javac ever
             runs, so `mvn clean package` failed on any machine whose default JDK had moved
             past 21. The release level below is what decides the bytecode target; the
             plugin version only has to be new enough to drive a modern javac. -->
        <version>3.14.0</version>
        <configuration>
          <release>21</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <minimizeJar>true</minimizeJar>
              <filters>
                <filter>
                  <artifact>org.bstats:*</artifact>
                  <includes>
                    <include>**</include>
                  </includes>
                </filter>
              </filters>
              <relocations>
                <relocation>
                  <pattern>com.zaxxer.hikari</pattern>
                  <shadedPattern>dev.boondock.bsanticheat.shaded.com.zaxxer.hikari</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>org.bstats</pattern>
                  <shadedPattern>dev.boondock.bsanticheat.shaded.bstats</shadedPattern>
                </relocation>
              </relocations>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
